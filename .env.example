# Server-only inference selection: mock, huggingface, nvidia-build, or local.
# Keep secrets in .env.local or deployment settings; no provider credential is
# read by a browser component.
FORMA_INFERENCE_PROVIDER=mock

# Hugging Face Inference Providers. Create a fine-grained token with
# "Make calls to Inference Providers" permission and store it only server-side.
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
HF_REASONING_MODEL=openai/gpt-oss-120b:fastest
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct:fastest
HF_ALLOW_MOCK_FALLBACK=true

# NVIDIA Build provider.
NVIDIA_API_KEY=
NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=
NVIDIA_GENERATION_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_PARSE_MODEL=
NVIDIA_BUILD_ALLOW_MOCK_FALLBACK=true
NVIDIA_BUILD_STRUCTURED_MODE=auto
# Interpreter with product_pipeline/requirements-inference.txt installed.
FORMA_PYTHON_BIN=python
# Optional hosted bridge endpoint. Vercel automatically uses /api/nvidia_bridge
# on its own deployment; set this only for a separate private Python service.
FORMA_NVIDIA_BRIDGE_URL=

# Server-only NemoClaw orchestration backend base URL. Forma appends /generate.
NEMOCLAW_BACKEND_URL=

# Optional local NVIDIA NIM endpoints. Set FORMA_INFERENCE_PROVIDER=local to use
# these. When omitted, Forma Labs stays in explicit deterministic mock mode.
FORMA_REASONING_URL=
FORMA_VISION_URL=
FORMA_PARSE_URL=

# Local OpenCAD services. Keep these server-side; the Next routes proxy browser
# requests so engineering geometry does not need to leave the workstation.
OPENCAD_URL=http://127.0.0.1:8000
OPENCAD_VIEWPORT_URL=http://127.0.0.1:5173
