{
  "name": "caid-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "server": "node --env-file-if-exists=.env.local server/index.mjs",
    "start": "npm run server",
    "test:server": "node --test server/*.test.mjs",
    "evaluate": "node --env-file-if-exists=.env.local server/evaluate.mjs",
    "dev:server": "CAID_PORT=8787 node --env-file-if-exists=.env.local server/index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
